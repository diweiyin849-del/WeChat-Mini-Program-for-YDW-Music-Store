.product{border-radius:24rpx;overflow:hidden;background:#fffdf8;border:1rpx solid #ece4d7}.cover{height:264rpx;position:relative;background:linear-gradient(135deg,#e7dfd1,#d1c0a2)}.cover-guitar,.cover-guzheng{background:linear-gradient(140deg,#eee0ce,#cfaa80)}.cover-violin,.cover-erhu{background:linear-gradient(140deg,#eee0d5,#bd9b87)}.cover-drums,.cover-digital-piano{background:linear-gradient(140deg,#e3e4e0,#adb5ab)}.cover image{width:100%;height:100%}.art{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column}.music{font-family:Georgia,serif;font-size:122rpx;line-height:1.15;color:#65533a;opacity:.7;transform:rotate(-10deg)}.art-label{font-size:19rpx;color:#867762;letter-spacing:3rpx;margin-top:10rpx}.tag{position:absolute;top:16rpx;left:16rpx;background:#fff9ee;padding:6rpx 12rpx;border-radius:9rpx;font-size:21rpx}.info{padding:22rpx}.name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:27rpx;color:#2e2d27;min-height:76rpx}.model{display:block;font-size:22rpx;color:#9a9285;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.price{margin-top:16rpx;font-size:31rpx;font-weight:600;color:#8e642d}.from{font-size:20rpx;color:#a99c87;margin-left:8rpx}
