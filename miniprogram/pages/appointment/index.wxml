<view class="page"><view class="title">预约到店试琴</view><view class="notice">{{demo ? '演示预约仅保存到本机，不会发送给琴行。' : '提交预约意向后等待琴行确认，不自动锁定档期。'}}时间按纽约当地时间显示，未来30天可选。</view><view wx:if="{{loading}}" class="loading">正在读取商品…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{product}}"><view class="card"><view class="section-title">{{product.title}}</view><view class="muted spaced">{{product.model}} · {{sku.label}}</view></view><view class="card"><view class="field"><text class="label">预约日期（纽约）</text><picker range="{{dates}}" value="{{dateIndex}}" data-field="dateIndex" bindchange="pick" disabled="{{submitting}}"><view class="picker">{{dates[dateIndex]}} ▾</view></picker></view><view class="field"><text class="label">意向到店时间</text><picker range="{{times}}" value="{{timeIndex}}" data-field="timeIndex" bindchange="pick" disabled="{{submitting}}"><view class="picker">{{times[timeIndex]}} ▾</view></picker></view><view class="field"><text class="label">联系人</text><input value="{{contact}}" data-field="contact" bindinput="input" maxlength="30" disabled="{{submitting}}"/></view><view class="field"><text class="label">联系电话（可带国家代码+号）</text><input value="{{phone}}" data-field="phone" bindinput="input" maxlength="16" disabled="{{submitting}}"/></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{note}}" data-field="note" bindinput="input" maxlength="500" disabled="{{submitting}}"/></view><view class="muted spaced">联系方式仅用于试琴预约联系，具体时间和服务由琴行确认。</view></view><view wx:if="{{saved}}" class="notice">{{demo ? '待确认（演示）：已保存在本机，未发送给琴行。' : '已提交，等待琴行确认。'}}</view><button class="primary spaced" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || saved || loading}}">{{saved ? '已保存' : demo ? '保存演示预约' : '提交试琴预约'}}</button><button class="secondary spaced" bindtap="list">查看我的预约</button></block></view>
