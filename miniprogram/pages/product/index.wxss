.photo{height:500rpx;background:linear-gradient(135deg,#e9e0d1,#c7b493);border-radius:28rpx;overflow:hidden}.photo swiper,.photo image{width:100%;height:100%}.art{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8a785d;font-size:24rpx}.art text{font:190rpx Georgia;color:#6f5d43;line-height:1.2}.product-title{font-size:37rpx;font-weight:600;margin:18rpx 0 6rpx;word-break:break-all}.sku-list{display:flex;flex-wrap:wrap;gap:14rpx}.sku{font-size:25rpx;border:2rpx solid #e5dccd;padding:14rpx 20rpx;border-radius:14rpx;color:#867964}.sku.chosen{border-color:#987244;background:#f4eadc;color:#79552a}.description{margin-top:20rpx;color:#70695d;white-space:pre-wrap;word-break:break-all}.bottom-bar button{font-size:26rpx;padding:20rpx 23rpx}
