<view class="page with-bottom"><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh" class="spaced">重试</button></view>
 <block wx:if="{{product}}"><view class="photo"><swiper wx:if="{{product.images.length && !imageFailed}}" indicator-dots circular><swiper-item wx:for="{{product.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" binderror="imageError"/></swiper-item></swiper><view wx:else class="art"><text>♪</text><view>商品图片展示占位</view></view></view>
 <view class="card"><text class="pill">{{product.brand}}</text><view class="product-title">{{product.title}}</view><view class="muted">{{product.model}}</view><view class="row spaced"><text class="price">¥{{sku.priceText}}</text><text class="muted">可售库存 {{sku.stock}} 件</text></view><view class="divider"></view><text class="label">选择规格</text><view class="sku-list"><view wx:for="{{product.skus}}" wx:key="id" class="sku {{selectedIndex === index ? 'chosen' : ''}}" data-index="{{index}}" bindtap="selectSku">{{item.label}}</view></view></view>
 <view class="actions spaced"><button class="secondary" bindtap="favorite">{{favorited ? '★ 已收藏' : '☆ 收藏'}}</button><button class="secondary" bindtap="addCompare">{{inComparison ? '已加入对比' : '加入对比'}}</button><button class="secondary" bindtap="compare">查看对比</button></view><button class="secondary spaced" bindtap="care">查看这类乐器的养护指南</button><button class="secondary spaced" bindtap="appointment">预约到店试琴</button><button class="primary spaced" bindtap="consult">咨询这款乐器 · 确认库存 / 预约试琴</button><view class="card"><view class="section-title">商品参数</view><view class="description">尺寸：{{product.specs.dimensions || '尚未填写'}}
材质：{{product.specs.material || '尚未填写'}}
适合人群：{{product.specs.audience || '尚未填写'}}
配件清单：{{product.specs.accessories || '尚未填写'}}</view></view><view class="card"><view class="section-title">商品介绍</view><view class="description">{{product.description}}</view></view><view class="card" wx:if="{{shop}}"><view class="section-title">联系琴行 · 到店试琴</view><view class="description">联系电话：{{shop.phone || '待填写'}}
营业时间：{{shop.hours || '待填写'}}
详细地址：{{shop.address || '待填写'}}</view><view wx:if="{{shop.phone === '123456' || shop.address === '纽约（演示地址）'}}" class="muted spaced">当前电话和纽约地址为演示资料，正式使用前请替换。</view><button class="secondary spaced" bindtap="consult">咨询库存与到店时间</button></view>
<view class="card"><view class="section-title">配送与自提</view><view class="description" wx:if="{{shop.shipping}}">纽约市普通乐器配送：¥{{shop.shipping.localFen / 100}}
美国其他城市普通乐器配送：¥{{shop.shipping.regionalFen / 100}}
钢琴配送：¥{{shop.shipping.pianoFen / 100}} / 次，不叠加普通运费
美国以外普通配送：¥{{shop.shipping.internationalFen / 100}}；境外钢琴：¥{{shop.shipping.internationalPianoFen / 100}} / 次，不叠加 · 到店自提免费</view><view class="description">{{deliveryNote || '具体配送安排请联系琴行。'}}</view><view class="description">{{serviceNotes.piano}}</view></view>
<view class="card"><view class="section-title">保修与维修</view><view class="description">{{serviceNotes.warranty}}</view><view class="description">{{serviceNotes.repair}}</view><button class="secondary spaced" bindtap="consult">咨询配送与售后</button></view><view class="notice">购物演示，不会真实扣款；模拟订单仅本机保存</view>
 <view class="bottom-bar"><text class="link" bindtap="cart">购物车</text><button class="secondary" disabled="{{!sku.stock}}" bindtap="add">加入购物车</button><button class="primary" disabled="{{!sku.stock}}" bindtap="preview">查看费用</button></view></block>
</view>
