<view class="page"><view class="title">{{selectable ? '选择收货地址' : '本机地址'}}</view><view class="subtitle">仅存储在当前设备，不会跨设备同步</view>
 <block wx:if="{{!editing}}"><view wx:for="{{addresses}}" wx:key="id" class="card"><view data-id="{{item.id}}" bindtap="select"><view class="row"><text>{{item.contact}} · {{item.phone}}</text><text wx:if="{{item.isDefault}}" class="pill">默认</text></view><view class="muted spaced">{{item.regionNames[0]}} {{item.regionNames[1]}} {{item.regionNames[2]}}</view><view class="break">{{item.detail}}</view><view wx:if="{{selectable}}" class="link spaced">使用此地址 ›</view></view><view class="actions"><button data-id="{{item.id}}" bindtap="edit">编辑</button><button data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view wx:if="{{!addresses.length}}" class="empty">暂无收货地址</view><button class="primary spaced" bindtap="add">＋ 添加地址</button></block>
 <view wx:else class="card"><view class="section-title">{{form.id ? '编辑地址' : '新增地址'}}</view><view class="field"><text class="label">联系人</text><input data-field="contact" value="{{form.contact}}" bindinput="input" placeholder="收货联系人" maxlength="30"/></view><view class="field"><text class="label">联系电话</text><input data-field="phone" value="{{form.phone}}" bindinput="input" placeholder="手机号码" type="number" maxlength="11"/></view><view class="field"><text class="label">省、市、区县</text><picker mode="region" value="{{form.regionNames}}" bindchange="region"><view class="picker">{{form.provinceCode ? form.regionNames[0] + ' ' + form.regionNames[1] + ' ' + form.regionNames[2] : '请选择收货地区 ›'}}</view></picker></view><view class="field"><text class="label">详细地址</text><textarea data-field="detail" value="{{form.detail}}" bindinput="input" placeholder="街道、门牌号等" maxlength="200"/></view><view class="row spaced"><text>设为默认地址</text><switch checked="{{form.isDefault}}" bindchange="defaultChange" color="#8e642d"/></view><view class="actions"><button bindtap="cancel">取消</button><button bindtap="save" class="primary">保存到本机</button></view></view>
 <view class="notice">你可随时删除地址，或在「我的」中清除全部本机购物数据。</view>
</view>
