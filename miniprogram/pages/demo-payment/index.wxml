<view class="page"><view class="title">模拟付款</view><view class="notice">模拟支付，不会真实扣款。订单只保存在本机，不会发送给琴行。</view><view wx:if="{{loading}}" class="loading">正在读取订单…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view>
<view wx:if="{{order && !error}}" class="card"><view class="muted break">{{order.id}}</view><view class="amount">¥{{order.totalText}}</view><view class="muted">按提交时确认的金额演示付款</view><view wx:if="{{order.status === 'pending'}}" class="actions-stack"><button class="primary" bindtap="pay" data-outcome="success" disabled="{{paying || loading}}" loading="{{paying}}">模拟付款成功</button><button bindtap="pay" data-outcome="failure" disabled="{{paying || loading}}">模拟付款失败</button><button bindtap="pay" data-outcome="cancel" disabled="{{paying || loading}}">取消本次付款（保留待付款订单）</button></view><button wx:if="{{order.status !== 'pending'}}" bindtap="detail" class="secondary spaced">查看订单状态</button></view></view>
