.selection{width:42rpx;height:42rpx;border-radius:50%;border:2rpx solid #d4c7b4;text-align:center;line-height:38rpx;align-self:flex-start;margin-top:8rpx;flex-shrink:0}.selection.checked{background:#8e642d;border-color:#8e642d;color:white}.cart-info{flex:1;min-width:0}.cart-title{font-size:30rpx;font-weight:500;word-break:break-all}.cart-card .row{align-items:flex-start}.quantity{display:flex;border:1rpx solid #e3d9c9;border-radius:12rpx;overflow:hidden;align-items:center}.quantity text{display:block;padding:6rpx 16rpx;font-size:26rpx}.quantity text:nth-child(2){background:#f0eadd}.delete{font-size:23rpx;color:#9a8c77;text-align:right;margin-top:18rpx}.warning{color:#a35640;font-size:24rpx;margin-top:12rpx}.price{font-size:30rpx}
