<view class="page with-bottom"><view class="title">我的购物车</view><view class="subtitle">好声音，等你带回家</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="loading">正在更新商品…</view>
 <view wx:if="{{!loading && !items.length}}" class="empty"><text class="empty-mark">♫</text><view>购物车里还没有乐器</view><button class="primary spaced" bindtap="browse">去选一件喜欢的乐器</button></view>
 <view wx:for="{{items}}" wx:key="skuId" class="card cart-card"><view class="row"><view class="selection {{item.selected ? 'checked' : ''}}" data-id="{{item.skuId}}" bindtap="toggle">{{item.selected ? '✓' : ''}}</view><view class="cart-info"><view class="cart-title">{{item.title}}</view><view class="muted">{{item.label}}</view><view class="warning" wx:if="{{item.problem}}">{{item.problem}}</view><view class="row spaced"><text class="price">¥{{item.priceText}}</text><view class="quantity"><text data-id="{{item.skuId}}" data-delta="-1" bindtap="change">−</text><text>{{item.quantity}}</text><text data-id="{{item.skuId}}" data-delta="1" bindtap="change">＋</text></view></view><view class="delete" data-id="{{item.skuId}}" bindtap="remove">移除</view></view></view></view>
 <view class="notice" wx:if="{{items.length}}">费用预览不会生成订单或扣减库存</view><view class="bottom-bar"><view><view class="muted">商品小计，不含运费</view><view class="price">¥{{subtotalText}}</view></view><button class="primary" disabled="{{!canPreview || loading || error}}" bindtap="preview">查看费用</button></view>
</view>
