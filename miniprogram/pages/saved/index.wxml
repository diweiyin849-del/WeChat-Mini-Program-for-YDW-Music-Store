<view class="page"><view class="row"><view class="title">{{mode === 'compare' ? '商品对比' : '我的收藏'}}</view><text wx:if="{{mode === 'favorites'}}" class="link" bindtap="compare">查看对比 ›</text></view><view class="subtitle">{{mode === 'compare' ? '最多选择3款，可横向滑动查看' : '把喜欢的声音留在这里'}}</view>
 <view class="notice">保存在当前设备；价格和库存以最新商品资料为准。演示商品仅供预览。</view>
 <view wx:if="{{loading}}" class="loading">正在读取商品…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view>
 <view wx:if="{{!loading && !error && !products.length}}" class="empty">{{mode === 'compare' ? '还没有对比商品，请从商品页或收藏中添加' : '还没有收藏，去看看喜欢的乐器吧'}}<button class="primary spaced" bindtap="browse">浏览乐器</button></view>
 <block wx:if="{{mode === 'favorites'}}"><view class="grid"><view wx:for="{{products}}" wx:key="id"><product-card wx:if="{{!item.unavailable}}" product="{{item}}" bind:open="openProduct"/><view wx:else class="card muted">{{item.title}}</view><view class="saved-actions"><button wx:if="{{!item.unavailable}}" data-id="{{item.id}}" bindtap="addCompare">加入对比</button><button data-id="{{item.id}}" bindtap="remove">取消收藏</button></view></view></view></block>
 <scroll-view wx:elif="{{products.length}}" scroll-x class="compare-scroll"><view class="compare-columns" style="width: {{products.length * 300}}rpx;"><view wx:for="{{products}}" wx:key="id" class="compare-column"><image wx:if="{{item.image}}" class="compare-image" src="{{item.image}}" mode="aspectFit"/><view wx:else class="compare-image placeholder">♫</view><view class="compare-name">{{item.title}}</view><view class="compare-cell"><text class="muted">型号</text><text>{{item.model}}</text></view><view class="compare-cell"><text class="muted">最低规格价格</text><text class="price">{{item.unavailable ? '—' : '¥' + item.priceText}}</text></view><view class="compare-cell"><text class="muted">总库存</text><text>{{item.unavailable ? '已下架或不存在' : item.stockCount + ' 件'}}</text></view><view class="compare-cell parameter-cell"><text class="muted">尺寸</text><text>{{item.specs.dimensions || '尚未填写'}}</text></view><view class="compare-cell parameter-cell"><text class="muted">材质</text><text>{{item.specs.material || '尚未填写'}}</text></view><view class="compare-cell parameter-cell"><text class="muted">适合人群</text><text>{{item.specs.audience || '尚未填写'}}</text></view><view class="compare-cell parameter-cell"><text class="muted">配件清单</text><text>{{item.specs.accessories || '尚未填写'}}</text></view><view class="compare-cell details"><text class="muted">商品介绍</text><text>{{item.description || '暂无可用资料'}}</text></view><button wx:if="{{!item.unavailable}}" class="primary" data-id="{{item.id}}" bindtap="open">查看商品</button><button class="secondary spaced" data-id="{{item.id}}" bindtap="remove">移出对比</button></view></view></scroll-view>
</view>
