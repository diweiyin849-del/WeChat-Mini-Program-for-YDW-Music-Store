<view class="page"><view class="title">费用预览</view><view class="subtitle">选好交付方式，看看预计费用</view><view class="notice">{{demo ? "模拟支付，不会真实扣款；订单仅保存在本机" : "费用预览，暂未接入真实下单与付款"}}</view>
 <view class="card"><view class="section-title">交付方式</view><view class="mode-switch"><view class="mode {{fulfillment === 'delivery' ? 'chosen' : ''}}" data-value="delivery" bindtap="fulfillment">配送到家</view><view class="mode {{fulfillment === 'pickup' ? 'chosen' : ''}}" data-value="pickup" bindtap="fulfillment">到店自提</view></view>
 <view wx:if="{{fulfillment === 'delivery'}}" class="address" bindtap="chooseAddress"><block wx:if="{{address}}"><view class="row"><text>{{address.contact}} · {{address.phone}}</text><text class="link">更换 ›</text></view><view class="muted spaced">{{address.regionNames[0]}} {{address.regionNames[1]}} {{address.regionNames[2]}}</view><view>{{address.detail}}</view></block><view wx:else class="link">＋ 选择或添加收货地址</view></view>
 <view wx:else class="pickup"><view class="spaced">YDW琴行 · 美国纽约</view><view class="muted">{{shop.address || '门店资料尚未配置'}}</view><view wx:if="{{shop.hours}}" class="muted">营业时间：{{shop.hours}}</view><view class="field"><text class="label">自提联系人</text><input placeholder="联系人" value="{{contact}}" data-field="contact" bindinput="contact" maxlength="30"/></view><view class="field"><input placeholder="联系电话" type="text" value="{{phone}}" data-field="phone" bindinput="contact" maxlength="16"/></view></view>
 </view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="spaced" bindtap="refresh">重试</button></view><view wx:if="{{loading || quoteLoading}}" class="loading">正在重新计算费用…</view>
 <view wx:if="{{quote}}" class="card"><view class="section-title">商品清单</view><view wx:for="{{quote.items}}" wx:key="skuId" class="line-item"><view class="row"><text class="item-title">{{item.title}}</text><text>¥{{item.lineText}}</text></view><view class="row muted"><text>{{item.label}}</text><text>¥{{item.priceText}} × {{item.quantity}}</text></view></view><view class="divider"></view><view class="row"><text class="muted">商品小计</text><text>¥{{quote.subtotalText}}</text></view><view class="row spaced"><text class="muted">{{fulfillment === 'pickup' ? '自提费用' : '配送运费'}}</text><text>{{quote.shippingFen === null ? '暂不可计算' : '¥' + quote.shippingText}}</text></view><view class="divider"></view><view class="row"><text>预计合计</text><text class="price">{{quote.valid ? '¥' + quote.totalText : '暂不可预览'}}</text></view><view wx:for="{{quote.issues}}" wx:key="index" class="issue">{{item.message}}</view><button wx:if="{{priceChanged}}" bindtap="acceptPrices" class="secondary spaced">接受最新商品价格并重新预览</button></view>
 <view wx:if="{{demo}}" class="card"><view class="section-title">{{fulfillment === 'pickup' ? '期望自提时间' : '期望安排配送时间'}}</view><view class="muted">纽约门店当地时间 · America/New_York</view><picker range="{{dateOptions}}" bindchange="selectDate" disabled="{{submitting || loading}}"><view class="picker spaced">{{desiredDate || '请选择日期 ›'}}</view></picker><picker range="{{hourOptions}}" bindchange="selectHour" disabled="{{submitting || loading}}"><view class="picker spaced">{{desiredHour || '请选择时间 ›'}}</view></picker><view class="muted spaced">须晚于当前时间，待商家确认；不预留档期，配送时间不是国际运输到达承诺。</view></view><view class="muted spaced">费用报价不发送详细住址与电话。模拟订单只保存在本机，待付款不预留库存。</view><button wx:if="{{demo}}" class="primary spaced" bindtap="submitDemoOrder" loading="{{submitting}}" disabled="{{submitting || saved || loading || quoteLoading || !quote || !quote.valid || !desiredDate || !desiredHour}}">{{saved ? "已提交，请在我的模拟订单查看" : "提交模拟订单"}}</button><view class="actions"><button bindtap="cart">返回购物车</button><button bindtap="browse" class="primary">继续选购</button></view>
</view>
