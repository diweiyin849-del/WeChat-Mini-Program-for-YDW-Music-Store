.search-row{display:flex;gap:14rpx;margin-top:28rpx}.search-row input{flex:1;background:#fffdf8}.search-row button{padding:18rpx 24rpx;align-self:center;font-size:25rpx}.tabs{white-space:nowrap;margin-top:26rpx;width:100%}.tab{display:inline-block;padding:14rpx 22rpx;color:#8b867c;margin-right:10rpx;border-radius:99rpx;font-size:26rpx}.tab.active{background:#8e642d;color:#fffdf8}
.tab{vertical-align:bottom;text-align:center;border-radius:20rpx;min-width:112rpx}.tab-image{display:block;width:104rpx;height:104rpx;margin:0 auto 8rpx;border-radius:14rpx;background:#f5f0e6}.tab-count{font-size:20rpx;margin-top:6rpx;opacity:.85}
