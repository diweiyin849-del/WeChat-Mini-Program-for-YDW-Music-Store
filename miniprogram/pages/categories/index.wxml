<view class="page"><view class="title">乐器馆</view><view class="subtitle">寻找与你共鸣的声音</view>
 <view class="search-row"><input placeholder="搜索乐器、品牌、型号" value="{{keyword}}" bindinput="search" bindconfirm="submitSearch" confirm-type="search"/><button bindtap="submitSearch">搜索</button></view>
  <view class="card"><view class="row"><input type="digit" placeholder="最低价（元）" value="{{minYuan}}" data-field="minYuan" bindinput="filterInput"/><text>—</text><input type="digit" placeholder="最高价（元）" value="{{maxYuan}}" data-field="maxYuan" bindinput="filterInput"/></view><view class="row spaced"><text>初学者适用</text><switch checked="{{beginnerOnly}}" data-field="beginnerOnly" bindchange="filterSwitch" color="#8e642d"/></view><view class="row spaced"><text>仅看有库存</text><switch checked="{{inStockOnly}}" data-field="inStockOnly" bindchange="filterSwitch" color="#8e642d"/></view><view class="actions"><button bindtap="resetFilters">重置筛选</button><button class="primary" bindtap="refresh">应用筛选</button></view></view><scroll-view scroll-x class="tabs"><view class="tab {{!categoryId ? 'active' : ''}}" data-id="" bindtap="select">全部</view><view wx:for="{{categories}}" wx:key="id" class="tab {{categoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="select"><image wx:if="{{item.image}}" class="tab-image" src="{{item.image}}" mode="aspectFit"/><view>{{item.name}}</view><view class="tab-count">{{item.modelCount}} 款 · {{item.stockCount}} {{item.unit}}</view></view></scroll-view>
 <view class="row spaced"><text class="muted">{{products.length}} 件商品</text><picker range="{{sortNames}}" value="{{sortIndex}}" bindchange="sortChange"><text class="link">{{sortNames[sortIndex]}} ▾</text></picker></view>
 <view wx:if="{{error}}" class="error">{{error}}<button class="spaced" bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="loading">正在加载乐器…</view>
 <view class="grid"><product-card wx:for="{{products}}" wx:key="id" product="{{item}}" bind:open="openProduct"/></view>
 <view wx:if="{{!loading && !error && !products.length}}" class="empty"><text class="empty-mark">♫</text>没有找到商品，试试其他分类或关键词</view>
</view>
