<view class="page"><view class="title">{{admin ? '管理模拟订单' : '我的模拟订单'}}</view><view class="notice">模拟支付，不会真实扣款。本机订单不能跨设备查看。</view><view wx:if="{{loading}}" class="loading">正在读取…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><block wx:if="{{!error}}"><view class="card"><input value="{{query}}" bindinput="inputQuery" placeholder="搜索订单号、商品、规格、联系人" maxlength="120"/><view class="status-filters"><button wx:for="{{statuses}}" wx:key="value" class="small-button {{status === item.value ? 'chosen' : ''}}" bindtap="selectStatus" data-value="{{item.value}}">{{item.label}}</button></view></view><view wx:for="{{items}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><view class="row"><text class="pill">{{item.statusText}}</text><text>{{item.fulfillment === 'pickup' ? '到店自提' : '配送到家'}}</text></view><view wx:if="{{item.desiredTime}}" class="muted spaced">期望 {{item.desiredTime.date}} {{item.desiredTime.time}} · 纽约时间<view>{{item.confirmedTime ? '商家已确认 ' + item.confirmedTime.date + ' ' + item.confirmedTime.time : '待商家确认'}}</view></view><view class="order-title">{{item.items[0].title}} · {{item.items.length}}种规格</view><view class="row"><text class="muted order-id break">{{item.id}}</text><text class="price">¥{{item.totalText}} ›</text></view></view><view wx:if="{{!loading && !items.length}}" class="empty">暂无符合条件的订单，选好乐器后从费用预览提交<button bindtap="resetFilters">清空搜索和筛选</button></view></block></view>
