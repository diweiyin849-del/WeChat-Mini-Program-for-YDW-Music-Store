.brand-row{display:flex;justify-content:space-between;align-items:center;margin:10rpx 0 30rpx}.brand{font-size:38rpx;font-weight:600;letter-spacing:5rpx}.brand-en{font-size:17rpx;letter-spacing:3rpx;color:#938674;margin-top:3rpx}.location{font-size:23rpx;color:#8b7f6e;background:#ebe5d9;border-radius:99rpx;padding:9rpx 20rpx}.hero{height:460rpx;background:#e7d9bd;border-radius:30rpx;overflow:hidden;position:relative;padding:40rpx}.hero-copy{position:relative;z-index:2}.eyebrow{font-size:23rpx;letter-spacing:3rpx;color:#836b45}.hero-title{font-size:58rpx;font-weight:600;line-height:1.27;letter-spacing:5rpx;margin-top:23rpx}.hero-sub{font-size:22rpx;color:#7e6f56;margin-top:18rpx}.hero-btn{background:#373b2f;color:#f6f1e5;font-size:24rpx;width:230rpx;padding:18rpx 20rpx;margin-top:30rpx;border-radius:99rpx}.hero-circle{width:370rpx;height:370rpx;border-radius:50%;background:#d0bd94;position:absolute;right:-100rpx;top:30rpx}.keyboard{position:absolute;right:-44rpx;bottom:-120rpx;width:330rpx;height:350rpx;display:flex;transform:rotate(-26deg);border:12rpx solid #383b33;border-top:70rpx solid #383b33;border-radius:12rpx;background:#34382f;box-shadow:0 15rpx 30rpx #9c8c7060;z-index:1}.key{height:100%;flex:1;border:1rpx solid #ccc5b7;background:#f6f0e4;position:relative;border-radius:0 0 5rpx 5rpx}.black-key{position:absolute;top:0;right:-11rpx;width:20rpx;height:150rpx;background:#30332c;z-index:2;border-radius:0 0 4rpx 4rpx}.hero-note{position:absolute;right:100rpx;top:26rpx;color:#8f7b54;font-size:120rpx;transform:rotate(18deg);opacity:.5}.benefits{display:flex;justify-content:space-between;font-size:23rpx;color:#7d7464;padding:24rpx 2rpx;border-bottom:1rpx solid #e8e0d2}.category-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24rpx 12rpx;margin-top:24rpx}.category{text-align:center;font-size:25rpx}.category-icon{width:96rpx;height:96rpx;background:#eae2d4;margin:0 auto 10rpx;border-radius:28rpx;color:#8c7149;font-size:48rpx;line-height:96rpx}.store-note{margin:50rpx 0 12rpx;padding:32rpx 0;text-align:center;border-top:1rpx solid #e4dccd;color:#9a907f;font-size:22rpx}.store-note text{display:block;margin-top:10rpx}.store-note .store-note-title{font-size:28rpx;color:#76674e}
.category-picture{display:block;width:120rpx;height:120rpx;margin:0 auto 10rpx;border-radius:24rpx;background:#f5f0e6}.category-count{display:block;font-size:20rpx;color:#8a7a62;margin-top:6rpx;white-space:nowrap}
