.admin-tabs{display:flex;gap:12rpx;padding:8rpx;background:#ece4d7;border-radius:18rpx;margin-top:25rpx}.admin-tab{flex:1;text-align:center;padding:16rpx;border-radius:12rpx;color:#88765b}.admin-tab.active{background:#fffdf8;color:#7f5a2d}.admin-title{flex:1;min-width:0;word-break:break-all}.small-button{padding:12rpx 25rpx;font-size:25rpx}.sku-editor{background:#f6f2ea;border-radius:18rpx;padding:24rpx;margin-top:20rpx}.two-fields{display:flex;gap:18rpx}.two-fields .field{flex:1;min-width:0}.image-list{display:flex;flex-wrap:wrap;gap:18rpx;margin-top:18rpx}.image-item{width:150rpx;text-align:center;color:#9a7860;font-size:23rpx}.image-item image{width:150rpx;height:150rpx;border-radius:14rpx}.image-item text{display:block}switch{transform:scale(.85);transform-origin:right center}
