<view class="page"><view class="title">{{demo ? '演示商品管理' : '商家管理'}}</view><view wx:if="{{loading}}" class="loading">正在验证管理员权限…</view><view wx:if="{{error}}" class="error">{{error}}<button class="spaced" bindtap="refresh">重试</button></view>
 <block wx:if="{{allowed}}"><view class="card"><view class="section-title">库存预警 · {{lowStock.length}}个规格</view><view class="muted">低于门店预警阈值时提示补货；0表示关闭。</view><view wx:for="{{lowStock}}" wx:key="skuId" class="row spaced"><view><view>{{item.title}} · {{item.label}}</view><view class="stock-warning">{{item.soldOut ? '售罄' : '剩余 ' + item.stock + ' 件，请补货'}}</view></view><button class="small-button" data-id="{{item.productId}}" bindtap="editProduct">补库存</button></view></view><button wx:if="{{demo}}" class="secondary spaced" bindtap="orders">管理模拟订单</button><button class="secondary spaced" bindtap="checkAppointmentSetup">检查预约与提醒配置</button><view wx:if="{{appointmentSetup}}" class="notice">云连接：{{appointmentSetup.cloudConnected ? '已连接' : '未验证'}} · 管理员：{{appointmentSetup.adminAllowed ? '已验证' : '未验证'}} · 提醒：{{appointmentSetup.reminderEnabled ? '已配置' : '未启用'}}<view>{{appointmentSetup.reason}}</view></view><view wx:if="{{demo}}" class="notice">演示管理：所有修改只保存到本机，不影响真实商品。</view><button class="secondary spaced" bindtap="appointments">管理试琴预约</button><view class="admin-tabs"><view class="admin-tab {{tab === 'products' ? 'active' : ''}}" data-value="products" bindtap="tab">商品</view><view class="admin-tab {{tab === 'categories' ? 'active' : ''}}" data-value="categories" bindtap="tab">分类</view><view class="admin-tab {{tab === 'shop' ? 'active' : ''}}" data-value="shop" bindtap="tab">店铺</view></view>
 <block wx:if="{{tab === 'products'}}"><block wx:if="{{!form}}"><button class="primary spaced" bindtap="addProduct">＋ 新增商品</button><view wx:for="{{products}}" wx:key="id" class="card"><view class="row"><text class="admin-title">{{item.title}}</text><text class="pill">{{item.status === 'active' ? '已上架' : '已下架'}}</text></view><view class="row spaced"><text class="price">¥{{item.priceText}}起</text><button class="small-button" data-id="{{item.id}}" bindtap="editProduct">编辑</button></view></view><view wx:if="{{!products.length}}" class="empty">暂无商品，添加第一件乐器吧</view></block>
 <view wx:else class="card"><view class="section-title">编辑商品</view><view class="muted break">编码：{{form.id}}</view><view class="field"><text class="label">商品名称</text><input value="{{form.title}}" data-field="title" bindinput="formInput" maxlength="120"/></view><view class="field"><text class="label">分类</text><picker range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="categoryChange"><view class="picker">{{categoryNames[categoryIndex]}} ▾</view></picker></view><view class="field"><text class="label">品牌</text><input value="{{form.brand}}" data-field="brand" bindinput="formInput" maxlength="60"/></view><view class="field"><text class="label">型号</text><input value="{{form.model}}" data-field="model" bindinput="formInput" maxlength="60"/></view><view class="section-title spaced">商品参数</view><view class="field"><text class="label">尺寸</text><input value="{{form.specs.dimensions}}" data-field="specs.dimensions" bindinput="formInput" maxlength="500"/></view><view class="field"><text class="label">材质</text><input value="{{form.specs.material}}" data-field="specs.material" bindinput="formInput" maxlength="500"/></view><view class="field"><text class="label">适合人群</text><input value="{{form.specs.audience}}" data-field="specs.audience" bindinput="formInput" maxlength="500"/></view><view class="field"><text class="label">配件清单</text><textarea value="{{form.specs.accessories}}" data-field="specs.accessories" bindinput="formInput" maxlength="500"/></view><view class="row spaced"><text>初学者适用</text><switch checked="{{form.beginnerFriendly}}" data-field="beginnerFriendly" bindchange="parameterSwitch" color="#8e642d"/></view><view class="field"><text class="label">商品介绍</text><textarea value="{{form.description}}" data-field="description" bindinput="formInput" maxlength="3000"/></view><view class="field"><text class="label">配送服务说明</text><textarea value="{{form.deliveryDescription}}" data-field="deliveryDescription" bindinput="formInput" maxlength="1000"/></view><view class="row spaced"><text>上架商品</text><switch checked="{{form.status === 'active'}}" bindchange="statusChange" color="#8e642d"/></view><view class="row spaced"><text>首页推荐</text><switch checked="{{form.featured}}" bindchange="featuredChange" color="#8e642d"/></view>
 <view class="divider"></view><view class="section-title">商品图片</view><view class="muted">云端支持512KB以内的PNG/JPEG图片</view><view class="image-list"><view wx:for="{{form.images}}" wx:key="*this" class="image-item"><image src="{{item}}" mode="aspectFill"/><text data-index="{{index}}" bindtap="removeImage">移除</text></view></view><button class="secondary spaced" bindtap="upload" loading="{{uploading}}" disabled="{{uploading || saving}}">添加图片</button>
 <view class="divider"></view><view class="section-title">规格与库存</view><view wx:for="{{form.skus}}" wx:key="id" class="sku-editor"><view class="row"><text class="muted">规格 {{index + 1}}</text><text class="link" data-index="{{index}}" bindtap="removeSku">移除</text></view><view class="field"><text class="label">规格名称</text><input value="{{item.label}}" data-index="{{index}}" data-field="label" bindinput="skuInput" maxlength="60"/></view><view class="two-fields"><view class="field"><text class="label">价格（元）</text><input value="{{item.priceYuan}}" data-index="{{index}}" data-field="priceYuan" bindinput="skuInput" type="digit"/></view><view class="field"><text class="label">可售库存</text><input value="{{item.stockText}}" data-index="{{index}}" data-field="stockText" bindinput="skuInput" type="number"/></view></view></view><button class="secondary spaced" bindtap="addSku">＋ 添加规格</button><view class="actions"><button bindtap="closeForm">取消</button><button class="primary" bindtap="saveProduct" loading="{{saving}}" disabled="{{saving || uploading}}">保存商品</button></view></view></block>
 <block wx:if="{{tab === 'categories'}}"><block wx:if="{{!categoryForm}}"><button class="primary spaced" bindtap="addCategory">＋ 新增分类</button><view wx:for="{{categories}}" wx:key="id" class="card row"><view><view>{{item.name}}</view><view class="muted">排序 {{item.sort}}</view></view><button data-id="{{item.id}}" bindtap="editCategory" class="small-button">编辑</button></view></block><view wx:else class="card"><view class="muted break">分类编码：{{categoryForm.id}}</view><view class="field"><text class="label">分类名称</text><input value="{{categoryForm.name}}" data-field="name" bindinput="categoryInput" maxlength="30"/></view><view class="field"><text class="label">排序（越小越靠前）</text><input value="{{categoryForm.sortText}}" data-field="sortText" bindinput="categoryInput" type="number"/></view><view class="actions"><button bindtap="closeForm">取消</button><button bindtap="saveCategory" class="primary">保存分类</button></view></view></block>
 <view wx:if="{{tab === 'shop' && shopForm}}" class="card"><view class="section-title">YDW琴行 · 美国纽约</view><view class="field"><text class="label">门店详细地址</text><input value="{{shopForm.address}}" data-field="address" bindinput="shopInput" maxlength="200"/></view><view class="field"><text class="label">联系电话</text><input value="{{shopForm.phone}}" data-field="phone" bindinput="shopInput" maxlength="30"/></view><view class="field"><text class="label">营业时间</text><input value="{{shopForm.hours}}" data-field="hours" bindinput="shopInput" maxlength="80"/></view><view class="divider"></view><view class="section-title">运费配置（元）</view><view class="field"><text class="label">纽约市普通配送</text><input value="{{shopForm.localYuan}}" data-field="localYuan" bindinput="shopInput" type="digit"/></view><view class="field"><text class="label">美国其他城市普通配送</text><input value="{{shopForm.regionalYuan}}" data-field="regionalYuan" bindinput="shopInput" type="digit"/></view><view class="field"><text class="label">钢琴配送，不叠加普通运费</text><input value="{{shopForm.pianoYuan}}" data-field="pianoYuan" bindinput="shopInput" type="digit"/></view><view class="notice">美国以外也支持演示配送；到店自提始终免费。修改后下次费用预览立即使用新配置。</view><view class="field"><text class="label">美国以外普通配送（元）</text><input value="{{shopForm.internationalYuan}}" data-field="internationalYuan" bindinput="shopInput" type="digit"/></view><view class="field"><text class="label">美国以外钢琴配送（元，不叠加）</text><input value="{{shopForm.internationalPianoYuan}}" data-field="internationalPianoYuan" bindinput="shopInput" type="digit"/></view><view class="field"><text class="label">库存预警阈值（低于此数量提示，0关闭）</text><input value="{{shopForm.lowStockThresholdText}}" data-field="lowStockThresholdText" bindinput="shopInput" type="number" maxlength="4"/></view><button bindtap="saveShop" class="primary spaced" loading="{{saving}}" disabled="{{saving}}">保存店铺配置</button></view>
 </block></view>
